APP_URL=https://sasimem-dev.web.app
# Testing phase: mail goes out through Gmail's SMTP as this account, with an app password
# in the GMAIL_APP_PASSWORD secret (params.ts). Gmail allows about 500 messages a day.
# Back to Resend: drop MAIL_PROVIDER and set MAIL_FROM to invoices@<sending domain>,
# once the domain has SPF, DKIM and DMARC (step 7).
MAIL_PROVIDER=gmail
MAIL_FROM=carbytuna@gmail.com

# Sign-up is by invitation (docs/PLAN-TEMPLATES.md §7): add one with ops/invite.ts.
SIGNUP_MODE=invite

# Empty: the default bucket, "<project>-retention" (functions/src/admin.ts).
RETENTION_BUCKET=

# The operator console (docs/PLAN-ADMIN-DASHBOARD.md §9): staff invitations' set-password links return here.
CONSOLE_URL=https://sasimem-ops-dev.web.app
