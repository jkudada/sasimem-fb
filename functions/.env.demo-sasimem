# Emulator project: approval links point at the Hosting emulator.
APP_URL=http://127.0.0.1:5000
# The emulator never sends real mail (it prints and writes _outbox); this only fills the parameter.
MAIL_FROM=invoices@mail.sasimem.example

# Sign-up is by invitation, as deployed (docs/PLAN-TEMPLATES.md §7); journeys invite their users.
SIGNUP_MODE=invite
