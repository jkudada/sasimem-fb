# Copy to .env.local (gitignored) with the project's public web config. Not secret.
# The console uses the same Firebase web app as the landlord app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# The reCAPTCHA Enterprise key's allowed domains must include the console's site.
VITE_RECAPTCHA_SITE_KEY=
