# Copy to .env.local (gitignored) for a build against a real project.
# These are public web config values, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sasimem-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sasimem-dev
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# App Check (plan §5): the reCAPTCHA Enterprise site key `node ops/app-check.ts` prints.
# A real build without it stops at start: every callable would refuse the app.
VITE_RECAPTCHA_SITE_KEY=
