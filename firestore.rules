rules_version = '2';
// Plan §5. Reads: members of an org. Writes: owners, for setup data only, validated
// field by field. Everything touching money, numbering, approval or sending is
// written by Cloud Functions through the Admin SDK and is closed here (I9).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }
    function isOwner(orgId) {
      return signedIn()
        && get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role == "owner";
    }
    // The operator console (PLAN-SUBSCRIBERS D10): the claim is set only by
    // ops/grant-operator.ts, and counts only when signed in with a second factor.
    // Operators read; every change they make goes through an audited callable.
    function isOperator() {
      return signedIn() && request.auth.token.get('operator', false) == true
        && request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null;
    }
    function canRead(orgId) { return isMember(orgId) || isOperator(); }

    // Rules cannot count, so a trigger keeps activeTenancyCount and the tenancy create
    // rule compares it with the limit (PLAN-SUBSCRIBERS §6). No subscription, no new tenancy.
    function underLimit(orgId) {
      let sub = get(/databases/$(database)/documents/subscriptions/$(orgId)).data;
      return sub.activeTenancyCount < sub.tenancyLimit;
    }

    // Field validation mirrors core's setup.ts limits (docs/test-lists/step-2.md).
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function wholeIn(v, min, max) { return v is int && v >= min && v <= max; }
    function exactly(d, keys) { return d.keys().hasOnly(keys) && d.keys().hasAll(keys); }
    // keys holds every required key and nothing beyond keys + optional.
    function shaped(d, keys, optional) { return d.keys().hasAll(keys) && d.keys().hasOnly(keys.concat(optional)); }
    // A template id an invoice is looked up by (docs/PLAN-TEMPLATES.md §3); a missing
    // template falls through to the next level at approval, so only the shape is checked.
    function templateRef(d, key) { return !(key in d) || (d[key] is string && d[key].matches('^[A-Za-z0-9_-]{1,64}$')); }
    function email(v) { return str(v, 3, 200) && v.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$'); }

    // Rules cannot loop, so the (at most 20) units are checked by index, like charges.
    function validUnit(u) { return u is map && exactly(u, ['id', 'label']) && str(u.id, 1, 64) && str(u.label.trim(), 1, 100); }
    function unitOk(us, i) { return us.size() <= i || validUnit(us[i]); }
    function validUnits(us) {
      return us is list && us.size() >= 1 && us.size() <= 20
        && unitOk(us, 0) && unitOk(us, 1) && unitOk(us, 2) && unitOk(us, 3) && unitOk(us, 4)
        && unitOk(us, 5) && unitOk(us, 6) && unitOk(us, 7) && unitOk(us, 8) && unitOk(us, 9)
        && unitOk(us, 10) && unitOk(us, 11) && unitOk(us, 12) && unitOk(us, 13) && unitOk(us, 14)
        && unitOk(us, 15) && unitOk(us, 16) && unitOk(us, 17) && unitOk(us, 18) && unitOk(us, 19);
    }

    function validProperty(d) {
      return shaped(d, ['address', 'useType', 'units'], ['templateId']) && templateRef(d, 'templateId')
        && str(d.address, 1, 200)
        && d.useType in ['residential', 'commercial']
        && validUnits(d.units);
    }

    function PROFILE_FIELDS() {
      return ['name', 'address', 'email', 'gstRegistered', 'gstNumber', 'bankName', 'bankAccount',
              'invoicePrefix', 'timezone', 'approvalLeadDays', 'sendHour', 'reminderAfterDays', 'reminderMode', 'logoPath',
              'defaultTemplateId', 'logoDesign', 'defaultTermsDays'];
    }

    // A logo lives in the org's own folder; storage.rules guards the file itself.
    function validLogo(orgId, d) {
      return !('logoPath' in d)
        || (d.logoPath is string && d.logoPath.matches('^logos/' + orgId + '/[A-Za-z0-9_-]{1,64}[.](png|jpg|jpeg|webp|gif)$'));
    }

    // The template new invoices use; a missing one falls back to Classic at approval.
    function validDefaultTemplate(d) { return templateRef(d, 'defaultTemplateId'); }

    // Mirrors core's templateProblems; ACCENTS in core/templates.ts is the same list.
    function validTemplate(d) {
      return exactly(d, ['name', 'layout', 'accent', 'font', 'mark', 'footer'])
        && str(d.name, 1, 40) && d.name.trim().size() > 0
        && d.layout in ['classic', 'band', 'compact']
        && d.accent in ['#0d6b4f', '#00677a', '#1f4e8c', '#6b3fa0', '#8a3b5c', '#a3312a', '#8a5300', '#2f3a45']
        && d.font in ['helvetica', 'times']
        && d.mark in ['logo', 'monogram', 'none']
        && str(d.footer, 0, 200);
    }

    // The logo builder's inputs, kept to reopen it (docs/PLAN-TEMPLATES.md §5). Mirrors
    // core's logoDesignProblems; LOGO_COLOURS is ACCENTS plus white and ink.
    function logoColour(c) {
      return c in ['#0d6b4f', '#00677a', '#1f4e8c', '#6b3fa0', '#8a3b5c', '#a3312a', '#8a5300', '#2f3a45', '#ffffff', '#1c2321'];
    }
    function validLogoDesign(d) {
      return !('logoDesign' in d) || (d.logoDesign is map
        && exactly(d.logoDesign, ['text', 'shape', 'background', 'colour', 'font', 'icon'])
        && str(d.logoDesign.text, 1, 24) && d.logoDesign.text.trim().size() > 0
        && d.logoDesign.shape in ['circle', 'rounded', 'none']
        && d.logoDesign.font in ['sans', 'serif', 'slab', 'script']
        && d.logoDesign.icon in ['none', 'house', 'building', 'key', 'palm', 'wave', 'mountain', 'leaf', 'star']
        && logoColour(d.logoDesign.background) && logoColour(d.logoDesign.colour)
        && !(d.logoDesign.shape == 'none' && d.logoDesign.colour == '#ffffff')
        && !(d.logoDesign.shape != 'none' && d.logoDesign.colour == d.logoDesign.background));
    }

    function validProfile(d) {
      return str(d.name, 1, 100) && str(d.address, 0, 200) && email(d.email)
        && d.gstRegistered is bool && str(d.gstNumber, 0, 30)
        && !(d.gstRegistered && d.gstNumber.trim().size() == 0) // printed on every tax invoice
        && str(d.bankName, 0, 100) && str(d.bankAccount, 0, 50)
        && str(d.invoicePrefix, 0, 10) && str(d.timezone, 1, 64)
        && wholeIn(d.approvalLeadDays, 1, 28) && wholeIn(d.sendHour, 0, 23) && wholeIn(d.reminderAfterDays, 0, 60)
        && d.reminderMode in ['auto', 'off']
        && (!('defaultTermsDays' in d) || wholeIn(d.defaultTermsDays, 0, 90)); // G2a: one-off invoices' default terms
    }

    // A tenant is a customer (docs/PLAN-GENERAL-INVOICING.md G1b): today's three fields,
    // plus optional business details, which mirror core's CUSTOMER_EXTRAS and customerProblems.
    function ccOk(xs, i) { return xs.size() <= i || email(xs[i]); }
    function validCc(xs) { return xs is list && xs.size() <= 3 && ccOk(xs, 0) && ccOk(xs, 1) && ccOk(xs, 2); }
    function optional(d, key, ok) { return !(key in d) || ok; }
    function validTenant(d) {
      return shaped(d, ['name', 'email', 'phone'], ['ccEmails', 'address', 'tin', 'gstNumber', 'termsDays', 'poRequired', 'notes'])
        && str(d.name, 1, 100) && email(d.email) && str(d.phone, 0, 30)
        && optional(d, 'ccEmails', validCc(d.get('ccEmails', [])))
        && optional(d, 'address', str(d.get('address', ''), 0, 200))
        && optional(d, 'tin', str(d.get('tin', ''), 0, 20))
        && optional(d, 'gstNumber', str(d.get('gstNumber', ''), 0, 20))
        && optional(d, 'termsDays', d.get('termsDays', null) == null || wholeIn(d.get('termsDays', null), 0, 90))
        && optional(d, 'poRequired', d.get('poRequired', false) is bool)
        && optional(d, 'notes', str(d.get('notes', ''), 0, 500));
    }

    function validExtra(e) {
      return e is map
        && exactly(e, ['id', 'description', 'amountToea', 'recurrence', 'period', 'active', 'gstTreatment'])
        && str(e.id, 1, 64) && str(e.description, 1, 100)
        && wholeIn(e.amountToea, -1000000000, 1000000000)
        && e.recurrence in ['every', 'one']
        && (e.period == null || (e.period is string && e.period.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')))
        && e.active is bool
        && e.gstTreatment in ['inherit', 'taxable', 'exempt'];
    }
    // Rules cannot loop, so the (at most 10) charges are checked by index.
    function extraOk(xs, i) { return xs.size() <= i || validExtra(xs[i]); }
    function validExtras(xs) {
      return xs is list && xs.size() <= 10
        && extraOk(xs, 0) && extraOk(xs, 1) && extraOk(xs, 2) && extraOk(xs, 3) && extraOk(xs, 4)
        && extraOk(xs, 5) && extraOk(xs, 6) && extraOk(xs, 7) && extraOk(xs, 8) && extraOk(xs, 9);
    }

    // One-off invoices (docs/PLAN-GENERAL-INVOICING.md G2a). Items and drafts are setup
    // data the owner writes; the shape and bounds mirror core's oneoff.ts and lines.ts.
    // A draft may be incomplete while it is written; issueInvoice checks it in full.
    function taxCode(v) { return v in ['standard', 'exempt', 'zero']; }
    function price(v) { return wholeIn(v, -1000000000, 1000000000); }
    function validItem(d) {
      return exactly(d, ['name', 'description', 'unit', 'unitPriceToea', 'taxCode'])
        && str(d.name, 1, 100) && d.name.trim().size() > 0 && str(d.description, 0, 200) && str(d.unit, 0, 12)
        && price(d.unitPriceToea) && taxCode(d.taxCode);
    }
    // Lines are checked in full where it matters: issueInvoice re-runs core's draftProblems
    // and line checks before anything is numbered. Here only the list and its size: checking
    // 30 lines field by field passes the rules engine's 1,000-expression limit per write.
    function validLines(ls) { return ls is list && ls.size() <= 30; }
    function validDraft(d) {
      return exactly(d, ['customerId', 'lines', 'poNumber', 'notes', 'dueDays'])
        && str(d.customerId, 0, 128) && validLines(d.lines) && str(d.poNumber, 0, 40) && str(d.notes, 0, 500)
        && (d.dueDays == null || wholeIn(d.dueDays, 0, 90));
    }

    function date(v) { return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }

    // The copies a tenancy carries (plan §4) must be true when it is created.
    function copiesMatch(orgId, d) {
      // getAfter, so a property, tenant and tenancy created in one batch are checked together.
      let tenant = getAfter(/databases/$(database)/documents/orgs/$(orgId)/tenants/$(d.tenantId)).data;
      let property = getAfter(/databases/$(database)/documents/orgs/$(orgId)/properties/$(d.propertyId)).data;
      return d.tenantName == tenant.name
        && d.propertyAddress == property.address
        && d.useType == property.useType
        && {'id': d.unitId, 'label': d.unitLabel} in property.units;
    }

    function validTenancy(d) {
      return wholeIn(d.rentToea, 0, 1000000000) && validExtras(d.extras)
        && wholeIn(d.billingDay, 1, 31) && wholeIn(d.dueDays, 0, 90)
        && shaped(d, ['propertyId', 'unitId', 'tenantId', 'tenantName', 'unitLabel', 'propertyAddress', 'useType',
                      'rentToea', 'startDate', 'endDate', 'billingDay', 'dueDays', 'referenceCode', 'invoiced', 'extras'], ['templateId'])
        && templateRef(d, 'templateId')
        && str(d.propertyId, 1, 128) && str(d.unitId, 1, 128) && str(d.tenantId, 1, 128)
        && date(d.startDate) && (d.endDate == null || (date(d.endDate) && d.endDate >= d.startDate))
        && d.referenceCode is string && d.referenceCode.matches('^[A-Za-z0-9]{1,12}$')
        && d.invoiced is bool;
    }

    match /orgs/{orgId} {
      allow read: if canRead(orgId);
      allow update: if isOwner(orgId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(PROFILE_FIELDS())
        && validProfile(request.resource.data) && validLogo(orgId, request.resource.data)
        && validDefaultTemplate(request.resource.data) && validLogoDesign(request.resource.data);

      // Invoice templates (docs/PLAN-TEMPLATES.md): setup data. At most 10 is kept by
      // the UI, as rules cannot count; approval copies the settings, so deleting one
      // never changes an issued invoice.
      match /templates/{templateId} {
        allow read: if canRead(orgId);
        allow create, update: if isOwner(orgId) && validTemplate(request.resource.data);
        allow delete: if isOwner(orgId);
      }

      match /properties/{propertyId} {
        allow read: if canRead(orgId);
        allow create, update: if isOwner(orgId) && validProperty(request.resource.data);
        // A property a tenancy uses is kept by the UI (core's deleteProblem); rules cannot
        // query. A tenancy carries its own copies, so drafting survives either way.
        allow delete: if isOwner(orgId);
      }

      // One-off invoices (G2a): the price list and drafts. Issuing is a callable (I9).
      match /items/{itemId} {
        allow read: if canRead(orgId);
        allow create, update: if isOwner(orgId) && validItem(request.resource.data);
        allow delete: if isOwner(orgId);
      }
      match /drafts/{draftId} {
        allow read: if canRead(orgId);
        allow create, update: if isOwner(orgId) && validDraft(request.resource.data);
        allow delete: if isOwner(orgId);
      }

      match /tenants/{tenantId} {
        allow read: if canRead(orgId);
        allow create, update: if isOwner(orgId) && validTenant(request.resource.data);
        allow delete: if isOwner(orgId); // as for properties
      }

      // Runs and invoices: members read them for the review screens; only Functions write (I9).
      match /runs/{period} {
        allow read: if canRead(orgId);
      }
      match /invoices/{invoiceId} {
        allow read: if canRead(orgId);
      }
      // The email log: members read it so a missing email shows up; it holds no bodies.
      match /emails/{emailId} {
        allow read: if canRead(orgId);
      }

      match /tenancies/{tenancyId} {
        allow read: if canRead(orgId);
        allow create: if isOwner(orgId) && validTenancy(request.resource.data)
          && request.resource.data.invoiced == false
          && copiesMatch(orgId, request.resource.data)
          && underLimit(orgId);
        // invoiced is server-set; the copies are kept true by a trigger (step 3), and
        // re-pointing a tenancy at another tenant or unit means a new tenancy.
        allow update: if isOwner(orgId) && validTenancy(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
               ['invoiced', 'propertyId', 'unitId', 'tenantId', 'tenantName', 'unitLabel', 'propertyAddress', 'useType']);
        // A billed tenancy is ended (endDate), never deleted (plan §4).
        allow delete: if isOwner(orgId) && resource.data.invoiced == false;
      }
    }

    // Subscribers (PLAN-SUBSCRIBERS §6). Plan, status, limits and payments are written
    // only by Functions (I9); the owner reads their own, the operator reads all.
    match /plans/{planId} {
      allow read: if signedIn();
    }
    match /subscriptions/{orgId} {
      allow read: if canRead(orgId);
      match /payments/{paymentId} {
        allow read: if canRead(orgId);
      }
      match /notes/{noteId} {
        allow read: if isOperator();
      }
    }
    match /operatorEvents/{eventId} {
      allow read: if isOperator();
    }
    // Invitations to sign up: written only by Functions (ops/invite.ts, the invite
    // callable); operators read them for the console's Invites page (S3).
    match /signupInvites/{email} {
      allow read: if isOperator();
    }
    // The tick's heartbeat, for the console's Health page; written only by the tick.
    match /system/{docId} {
      allow read: if isOperator();
    }
    // Sasimem's own bank details and contact, shown to every landlord on their banner
    // and Plan & billing page (S4); written only by ops/billing-details.ts.
    match /sasimem/{docId} {
      allow read: if signedIn();
    }
  }
}
