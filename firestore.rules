rules_version = '2';
// Plan §5. Reads: members of an org. Writes: owners, for setup data only, validated
// field by field. Everything touching money, numbering, approval or sending is
// written by Cloud Functions through the Admin SDK and is closed here (I9).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    match /orgs/{orgId} {
      allow read: if isMember(orgId);

      match /tenancies/{tenancyId} {
        allow read: if isMember(orgId);
      }
    }
  }
}
